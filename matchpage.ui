         <property name="styleSheet">
          <string notr="true">QTableWidget {
    background-color: #f9f9f9;
    border: 3px solid #b30000;
    border-radius: 10px;
    gridline-color: #dcdcdc;
    font-size: 14px;
    color: #000;
}

QTableWidget::item {
    padding: 10px;
    border-bottom: 1px solid #e0e0e0;
    color: #000000;
}

QTableWidget::item:selected {
    background-color: #b30000;  /* Red selection */
    color: white;
    font-weight: bold;
}

QTableWidget::item:hover {
    background-color: #ffe6e6;  /* Light red hover */
    color: #000;
}

QHeaderView::section {
    background-color: #b30000;
    color: white;
    padding: 6px 10px;
    font-size: 15px;
    font-weight: bold;
    border: 1px solid #990000;
    min-width: 120px;
    border-radius: 5px;
}

QTableCornerButton::section {
    background-color: #b30000;
    border: 1px solid #990000;
}

QTableWidget QWidget {
    background: transparent;
}

QTableWidget QPushButton {
    background-color: qlineargradient(spread:pad, 
                            x1:0, y1:0, x2:1, y2:1, 
                            stop:0 #b30000, 
                            stop:0.5 #e60000, 
                            stop:1 #ff4d4d);
    border-radius: 8px;
    color: white;
    font-size: 13px;
    min-width: 90px;
    min-height: 35px;
    border: none;
}

QTableWidget QPushButton:hover {
    background-color: qlineargradient(spread:pad,
                            x1:0, y1:0, x2:1, y2:1,
                            stop:0 #ffffff,
                            stop:1 #ffcccc);
    color: #b30000;
    font-weight: bold;
}
</string>
