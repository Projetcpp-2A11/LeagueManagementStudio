       <property name="styleSheet">
        <string notr="true">QTabBar::tab {
    background: qlineargradient(spread:pad,
                                x1:0, y1:0, x2:1, y2:1,
                                stop:0 #b30000,
                                stop:0.5 #d40000,
                                stop:1 #ff4d4d);
    color: white;
    border: 1px solid #990000;
    border-radius: 8px;
    padding: 10px 20px;
    margin: 2px;
    font: bold 12pt &quot;Segoe UI&quot;;
    min-width: 150px;
    transition: all 0.3s ease;
}

QTabBar::tab:selected {
    background: qlineargradient(spread:pad,
                                x1:0, y1:0, x2:1, y2:1,
                                stop:0 #ffffff,
                                stop:1 #ffcccc);
    color: #990000;
    font: bold 13pt &quot;Segoe UI&quot;;
    border: 2px solid #990000;
    border-bottom: none;
    border-radius: 8px 8px 0 0;
}

QTabBar::tab:hover {
    background: qlineargradient(spread:pad,
                                x1:0, y1:0, x2:1, y2:1,
                                stop:0 #ff6666,
                                stop:1 #ff9999);
    color: #000000;
    font: bold 12pt &quot;Segoe UI&quot;;
}

QTabWidget::pane {
    border: 2px solid #990000;
    border-top: none;
    border-radius: 0 0 8px 8px;
    background-color: #fefefe;
}
