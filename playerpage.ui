/* Hover effect */
QPushButton:hover {
    background: qlineargradient(spread:pad, 
                                x1:0.25, y1:0, x2:0.75, y2:1, 
                                stop:0 rgba(0, 255, 254, 255),     
                                stop:0.26 rgba(38, 170, 196, 255), 
                                stop:0.67 rgba(89, 85, 131, 255),
                                stop:1 rgba(0, 238, 255, 255));
    border: 2px solid #ff0004; /* Border change on hover */
    color: #ffffff;
    font-weight: bold;
}

/* Pressed effect */
QPushButton:pressed {
    background-color: #cc0000;
    border: 2px solid #990000;
    color: white;
    padding-left: 14px;
    padding-top: 14px;
    box-shadow: inset 0 0 10px rgba(0, 0, 0, 0.2); /* Shadow on press */
}
</string>
     </property>
     <property name="text">
      <string/>
     </property>
     <property name="icon">
      <iconset resource="resources.qrc">
       <normaloff>:/textures/textures/notifsIcon.png</normaloff>:/textures/textures/notifsIcon.png</iconset>
     </property>
     <property name="iconSize">
      <size>
       <width>50</width>
       <height>50</height>
      </size>
     </property>
    </widget>
    <zorder>notifButton</zorder>
